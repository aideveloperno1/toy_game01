# Local development: private files + HTTP synchronization. Do not commit real keys.
PORT=3001
DATA_DIR=.data/swa
# Required in Azure Static Web Apps > Environment variables (API settings):
# SESSION_SECRET=at-least-32-random-characters
# GAME_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# WEB_PUBSUB_CONNECTION_STRING=Endpoint=https://....webpubsub.azure.com;AccessKey=...;Version=1.0;
# Optional exact origin restriction (omit for multiple custom/preview domains):
# APP_ORIGIN=https://your-app.azurestaticapps.net
