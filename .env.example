# Local development uses atomic file storage. Never commit a real .env file.
PORT=3001
DATA_DIR=.data
# Production requires these (configure in Azure, not in the browser build):
# NODE_ENV=production
# APP_ORIGIN=https://your-app.azurewebsites.net
# SESSION_SECRET=replace-with-at-least-32-random-characters
# ADMIN_TOKEN=replace-with-a-different-random-secret
# AZURE_STORAGE_ACCOUNT=yourstorageaccount
# Prefer managed identity; connection string is optional for emulator testing.
# AZURE_STORAGE_CONNECTION_STRING=...
