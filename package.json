{
  "name": "bokbulbok",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "친구들과 내기할 때 쓰는 복불복 게임 모음 (사다리, 룰렛, 구슬 레이스 등 10종)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:local": "vite --host",
    "build:web": "tsc --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/build-server.mjs",
    "start": "node dist-server/index.mjs",
    "test:online": "vitest run tests/online",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.14.1",
    "@azure/storage-blob": "^12.34.0",
    "@fontsource/jua": "^5.3.0",
    "express": "^5.3.0",
    "matter-js": "^0.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
